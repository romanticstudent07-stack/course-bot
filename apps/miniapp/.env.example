# apps/miniapp/.env.example — переменные сборки Mini App (Vite, префикс VITE_ попадает в бандл!).
# НИКАКИХ секретов здесь: всё с префиксом VITE_ видно любому пользователю в браузере.
#
# Базовый URL API. Пусто = тот же origin (рекомендуется, CSP E2: connect-src 'self').
VITE_API_BASE_URL=
#
# Только для `npm run dev` на dev-машине: адрес API для прокси /miniapp/v1 и /healthz.
# Например: http://127.0.0.1:8080 (порт = APP_PORT из корневого .env).
VITE_DEV_API_PROXY=
