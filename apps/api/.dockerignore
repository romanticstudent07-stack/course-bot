# apps/api/.dockerignore — защита слоёв образа от лишнего и секретного.
# Синтаксис: как .gitignore. Всё, что попадает под шаблон, НЕ уйдёт в COPY.

# --- КРИТИЧНО: секреты никогда не в образ ---
.env
.env.*
*.env
!.env.example
*.key
*.pem
*.p12
secrets/

# --- Git и метаданные ---
.git
.gitignore
.gitattributes

# --- Python артефакты (генерятся заново в контейнере) ---
__pycache__
*.py[cod]
*.egg-info
.venv
venv
.pytest_cache
.mypy_cache
.ruff_cache
.tox
.coverage
htmlcov

# --- Docker (сам себя не тянем) ---
Dockerfile
docker-compose*.yml
.dockerignore

# --- IDE и ОС ---
.vscode
.idea
.DS_Store
Thumbs.db

# --- Логи и временное ---
*.log
logs/
*.sqlite3

# --- Тесты и документация (в prod-образ не нужны) ---
tests/
test/
docs/
*.md
!README.md
