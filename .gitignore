# ============================================================
# .gitignore — course-bot
# Правило: секреты и артефакты сборки НИКОГДА не попадают в git.
# .dockerignore в apps/*/ дублирует эту защиту на уровне образа.
# ============================================================

# --- КРИТИЧНО: секреты — НИКОГДА в репозиторий ---
.env
.env.*
*.env
!.env.example
.env.local
*.local
*.key
*.pem
*.p12
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# --- Node / Mini App (React + Vite) ---
node_modules/
dist/
/build/
apps/*/build/
.vite/
coverage/
*.tsbuildinfo
.eslintcache
.npm/
.pnpm-store/

# --- Логи и временные файлы ---
*.log
logs/
*.sqlite3
*.pid
*.seed

# --- Данные базы и хранилища (при docker-compose down -v могут остаться) ---
pgdata/
redis-data/

# --- Cloudflared (никогда не коммитить credentials туннеля) ---
.cloudflared/
*.cloudflared.json

# --- Редакторы и ОС ---
# .vscode: игнорируем всё, КРОМЕ settings.json (там правило «концы строк LF»)
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# --- Локальные скрипты Автора (не для репо) ---
scratch/
tmp/
# Локальный Postgres, логи и временные файлы агента (только внутри репо)
.tmp/
notes.local.md
