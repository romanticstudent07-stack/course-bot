# ============================================
# ОБРАЗЕЦ. Скопируйте в .env и заполните.
# Файл .env в Git НЕ попадает (см. .gitignore).
#
# Порты подобраны под сервер IRONCLAD (см. infra/SERVER-IRONCLAD.md):
#   5435 (Postgres), 6382 (Redis), 8080 (API), 9000/9001 (Garage S3)
#   — эти порты свободны; 5434/6381/8443 заняты maxmover, не трогать.
#   Все сервисы биндятся ТОЛЬКО на 127.0.0.1. Вход: dev — Tailscale serve
#   (только tailnet) на 127.0.0.1:5173; прод — позже через VPS (решение Автора).
# ============================================

# --- Telegram ---
BOT_TOKEN=
BOT_USERNAME=
WEBHOOK_SECRET=
WEBAPP_URL=
ADMIN_USER_ID=
WORK_GROUP_ID=
PUBLIC_CHANNEL_ID=

# --- Telegram initData (проверка в apps/api/app/telegram_init_data.py) ---
# Максимальный возраст auth_date в секундах. Старше — 401 TG_INIT_INVALID
# (Mini App нужно переоткрыть). По умолчанию 86400 (24 ч) — решение Автора.
# Источники расходятся (docs/DEFECTS-FOUND.md, D-9):
#   - build/miniapp-api-contract.yaml (securitySchemes.TelegramInitData): 24 ч;
#   - build/miniapp-security-checklist.md §2: ориентир 3600;
#   - 14-data-durability.md §14.13 / R325: 300 (write) / 3600 (read) + session_jwt.
# Без BOT_TOKEN все запросы /miniapp/v1/** получают 503 SERVICE_MISCONFIGURED.
INIT_DATA_MAX_AGE_SECONDS=86400

# ============================================
# АДРЕСА: внутри контейнеров vs на хосте
# ============================================
# Правило Docker: внутри контейнера "127.0.0.1" — это САМ этот контейнер.
# Чтобы api достучался до db, redis, garage — используем имена сервисов
# из docker-compose (`db`, `redis`, `garage`) как хосты (это DNS compose-сети).
# А "127.0.0.1:<port>" на хосте — это то, что видно с самого сервера и из Tailscale serve.

# --- FastAPI / API-сервис ---
# APP_HOST=0.0.0.0 — uvicorn должен слушать все интерфейсы внутри контейнера,
# иначе docker-proxy не прокинет запросы. Публикация наружу — 127.0.0.1 на хосте,
# см. docker-compose.dev.yml (`ports: 127.0.0.1:${APP_PORT}:${APP_PORT}`).
APP_HOST=0.0.0.0
# Не менять — зафиксировано в CMD uvicorn, HEALTHCHECK и compose publish
APP_PORT=8080
APP_PUBLISH_HOST=127.0.0.1

# --- PostgreSQL 16 ---
# Внутри compose-сети: POSTGRES_HOST_INTERNAL=db (имя сервиса).
# С хоста для psql/DBeaver: 127.0.0.1:${POSTGRES_PORT}.
POSTGRES_HOST_INTERNAL=db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=course_bot
POSTGRES_USER=course_bot
POSTGRES_PASSWORD=
# Лимит shared_buffers для локального Postgres (правило сервера ≤ 256 МБ).
POSTGRES_SHARED_BUFFERS=128MB

# --- Роли БД (B-3): пусто → всё как до B-3 (DSN из POSTGRES_*) ---
# DATABASE_URL — API (coursebot_api, роль app_api).
# PROJECTOR_DATABASE_URL — проектор (coursebot_projector, роль app_projector); у контейнера projector
#   это единственный путь к БД (env_file нет).
# MIGRATIONS_DATABASE_URL — alembic и python -m app.texts load (владелец, POSTGRES_USER).
# Формат: postgresql+psycopg://<пользователь>:<пароль>@db:5432/<POSTGRES_DB>
# Пароли — openssl rand -hex 24 (только 0-9a-f, экранировать не нужно).
DATABASE_URL=
PROJECTOR_DATABASE_URL=
MIGRATIONS_DATABASE_URL=

# --- Redis 7 (только некритичные данные: буфер аналитики, счётчики rate-limit) ---
# Внутри compose: redis://redis:6379/0. С хоста: redis://127.0.0.1:6382/0.
REDIS_URL=redis://redis:6379/0
REDIS_URL_EXTERNAL=redis://127.0.0.1:6382/0

# --- Rate-limit /miniapp/v1/** (B-1, apps/api/app/rate_limit.py) ---
# Не больше N запросов в минуту на одного пользователя (tg_user_id из проверенной initData).
# Превышение → 429 RATE_LIMITED + заголовок Retry-After. Счётчик — в Redis (REDIS_URL).
# Redis недоступен или REDIS_URL пуст → запрос проходит (fail-open), в логе api WARNING
# «rate-limit: redis unavailable (ИмяОшибки), fail-open».
RATE_LIMIT_PER_MINUTE=60

# --- S3 в РФ: dev = Garage (замена MinIO), prod = Yandex Object Storage ---
# Garage — S3-совместимое хранилище (Rust, крошечное, replication_factor=1 для dev).
# MinIO удалил официальные Docker-образы в сентябре 2026, заменён на Garage.
# Внутри compose: http://garage:3900. С хоста / из браузера: http://127.0.0.1:9000.
# prod — Yandex Object Storage / Timeweb / VK Cloud (решение Автора).
# Бакет фото: Object Lock ОТКЛЮЧЁН (иначе стирание невозможно).
# Бакет аудита: в prod — COMPLIANCE / WORM.
S3_ENDPOINT=http://garage:3900
S3_ENDPOINT_EXTERNAL=http://127.0.0.1:9000
S3_REGION=garage
S3_BUCKET_PHOTOS=photos
# Бакет audit создаётся ВРУЧНУЮ одной командой на Итерации 5.
# См. infra/README.md → раздел "Создание бакета audit".
S3_BUCKET_AUDIT=audit

# --- Ключи S3 (Garage) ---
# Формат по официальной документации Garage:
#   access_key = "GK" + 16 hex-байт = "GK" + 32 hex-символа (итого 34 символа)
#   secret_key = 32 hex-байта  (итого 64 hex-символа)
# Генерация (Linux/macOS):
#   S3_ACCESS_KEY="GK$(openssl rand -hex 16)"
#   S3_SECRET_KEY="$(openssl rand -hex 32)"
# Источник: https://garagehq.deuxfleurs.fr/documentation/quick-start/
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Внутренние секреты Garage (не путать с S3-ключами) ---
# GARAGE_RPC_SECRET — общий секрет между узлами кластера (у нас узел один,
#   но переменная всё равно обязательна). Ровно 32 hex-байта = 64 символа.
#   Генерация: openssl rand -hex 32
# GARAGE_ADMIN_TOKEN — bearer-токен для админ-API (порт 3903).
# GARAGE_METRICS_TOKEN — bearer-токен для /metrics.
# Все три перекрывают дефолтные значения из garage.toml (env имеет высший приоритет).
# Источник: https://deuxfleurs-org-garage-38.mintlify.app/cli/environment-variables
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=

# --- Оплата: ВАРИАНТ A (ручной, самозанятый) — активен сейчас ---
# Реквизиты, которые бот показывает клиенту при команде /pay
PAYMENT_MODE=manual
PAYMENT_CARD_NUMBER=            # например: 2200 XXXX XXXX XXXX
PAYMENT_CARD_HOLDER=            # ФИО как на карте
PAYMENT_SBP_PHONE=              # +7XXXXXXXXXX для СБП
PAYMENT_SBP_BANK=               # название банка получателя (Т-Банк, Сбер, ...)
PAYMENT_AMOUNT_RUB=             # цена курса, например 5000
PAYMENT_CURRENCY=RUB

# --- Оплата: ВАРИАНТ B (YooKassa для самозанятых) — на будущее ---
# Заполнить, когда переедем на автомат. Пока оставить пустым.
PSP_PROVIDER=                   # yookassa | robokassa | cloudpayments
PSP_SHOP_ID=
PSP_SECRET_KEY=
PSP_WEBHOOK_SECRET=
PSP_RETURN_URL=                 # URL Mini App, куда возвращать клиента после оплаты

# --- Часовой пояс ---
# Договорённость: в БД храним timestamptz (Postgres хранит в UTC под капотом),
# в приложении конвертим и отображаем в MSK.
# TZ внутри контейнеров = MSK, чтобы логи совпадали с меткой сервера.
TZ=Europe/Moscow
SERVER_TIMEZONE=Europe/Moscow

# --- Лимиты памяти контейнеров (правило IRONCLAD, не превышать) ---
# Суммарно ≤ 2 GB (решение Автора 25.09.2026; было 1.5 GB). Сейчас сумма лимитов 1792 МБ.
# Лимит — потолок; реальное потребление стека ~290 МБ по замеру 25.09.2026 (бот ~155 МБ).
MEM_LIMIT_API=384M
MEM_LIMIT_BOT=512M
MEM_LIMIT_DB=384M
MEM_LIMIT_REDIS=64M
MEM_LIMIT_GARAGE=192M
MEM_LIMIT_MINIAPP=128M
MEM_LIMIT_PROJECTOR=128M

# --- Прочее ---
LOG_LEVEL=INFO
