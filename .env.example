# ============================================
# ОБРАЗЕЦ. Скопируйте в .env и заполните.
# Файл .env в Git НЕ попадает (см. .gitignore).
#
# Порты подобраны под сервер IRONCLAD (см. infra/SERVER-IRONCLAD.md):
#   5435 (Postgres), 6382 (Redis), 8080 (API), 9000/9001 (MinIO)
#   — эти порты свободны; 5434/6381/8443 заняты maxmover, не трогать.
#   Все сервисы биндятся ТОЛЬКО на 127.0.0.1 — наружу только через Cloudflare.
# ============================================

# --- Telegram ---
BOT_TOKEN=
BOT_USERNAME=
WEBHOOK_SECRET=
WEBAPP_URL=
ADMIN_USER_ID=
WORK_GROUP_ID=
PUBLIC_CHANNEL_ID=

# --- FastAPI / API-сервис ---
# Публиковать API строго на loopback: 127.0.0.1 (правило IRONCLAD).
APP_HOST=127.0.0.1
APP_PORT=8080

# --- PostgreSQL 16 ---
# dev: локальный контейнер. prod: управляемая БД с PITR (Уровень 0).
# 5432 занят на VPS/Cloud обычно, а на IRONCLAD 5434 занят maxmover — берём 5435.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=course_bot
POSTGRES_USER=course_bot
POSTGRES_PASSWORD=
# Лимит shared_buffers для локального Postgres (правило сервера ≤ 256 МБ).
POSTGRES_SHARED_BUFFERS=128MB

# --- Redis 7 (только некритичный буфер аналитики) ---
# Критичные события пишутся синхронно в PostgreSQL.
# 6379 обычно свободен, но на IRONCLAD 6381 занят maxmover — берём 6382.
REDIS_URL=redis://127.0.0.1:6382/0

# --- S3 в РФ (провайдер — открытый вопрос Автора) ---
# На IRONCLAD внешнего S3 нет: dev поднимаем MinIO-контейнер (см. docker-compose.dev.yml).
# prod — Yandex Object Storage / Timeweb / VK Cloud (решение Автора).
# Бакет фото: Object Lock ОТКЛЮЧЁН (иначе стирание невозможно).
# Бакет аудита: COMPLIANCE / WORM.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=ru-central-1
S3_BUCKET_PHOTOS=photos
S3_BUCKET_AUDIT=audit
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Оплата: ВАРИАНТ A (ручной, самозанятый) — активен сейчас ---
# Реквизиты, которые бот показывает клиенту при команде /pay
PAYMENT_MODE=manual
PAYMENT_CARD_NUMBER=            # например: 2200 XXXX XXXX XXXX
PAYMENT_CARD_HOLDER=            # ФИО как на карте
PAYMENT_SBP_PHONE=              # +7XXXXXXXXXX для СБП
PAYMENT_SBP_BANK=               # название банка получателя (Т-Банк, Сбер, ...)
PAYMENT_AMOUNT_RUB=             # цена курса, например 5000
PAYMENT_CURRENCY=RUB

# --- Оплата: ВАРИАНТ B (YooKassa для самозанятых) — на будущее ---
# Заполнить, когда переедем на автомат. Пока оставить пустым.
PSP_PROVIDER=                   # yookassa | robokassa | cloudpayments
PSP_SHOP_ID=
PSP_SECRET_KEY=
PSP_WEBHOOK_SECRET=
PSP_RETURN_URL=                 # URL Mini App, куда возвращать клиента после оплаты

# --- Часовой пояс ---
# Правило IRONCLAD: timestamp в MSK. Внутри БД храним UTC, отображаем MSK.
# TZ — часовой пояс процессов; SERVER_TIMEZONE — фактический пояс машины.
TZ=UTC
SERVER_TIMEZONE=Europe/Moscow

# --- Лимиты памяти контейнеров (правило IRONCLAD, не превышать) ---
# Суммарно ≤ ~900 MB (RAM свободно ~4.6 ГиБ; maxmover занят ~750-900 MB).
MEM_LIMIT_API=384M
MEM_LIMIT_BOT=192M
MEM_LIMIT_DB=384M
MEM_LIMIT_REDIS=64M
MEM_LIMIT_MINIO=192M

# --- Прочее ---
LOG_LEVEL=INFO
