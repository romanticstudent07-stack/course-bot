# ============================================
# ОБРАЗЕЦ. Скопируйте в .env и заполните.
# Файл .env в Git НЕ попадает (см. .gitignore).
# ============================================

# --- Telegram ---
BOT_TOKEN=
BOT_USERNAME=
WEBHOOK_SECRET=
WEBAPP_URL=
ADMIN_USER_ID=
WORK_GROUP_ID=
PUBLIC_CHANNEL_ID=

# --- PostgreSQL 16 ---
# dev: локальный контейнер. prod: управляемая БД с PITR (Уровень 0)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Redis 7 (только некритичный буфер аналитики) ---
# Критичные события пишутся синхронно в PostgreSQL
REDIS_URL=

# --- S3 в РФ (провайдер — открытый вопрос Автора) ---
# Бакет фото: Object Lock ОТКЛЮЧЁН (иначе стирание невозможно)
# Бакет аудита: COMPLIANCE / WORM
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PHOTOS=
S3_BUCKET_AUDIT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- PSP / платежи (провайдер — открытый вопрос Автора) ---
PSP_SHOP_ID=
PSP_SECRET_KEY=
PSP_WEBHOOK_SECRET=

# --- Прочее ---
TZ=UTC
LOG_LEVEL=INFO
SERVER_TIMEZONE=
