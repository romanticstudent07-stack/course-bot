# ============================================
# ОБРАЗЕЦ. Скопируйте в .env и заполните.
# Файл .env в Git НЕ попадает (см. .gitignore).
#
# Порты подобраны под сервер IRONCLAD (см. infra/SERVER-IRONCLAD.md):
#   5435 (Postgres), 6382 (Redis), 8080 (API), 9000/9001 (MinIO)
#   — эти порты свободны; 5434/6381/8443 заняты maxmover, не трогать.
#   Все сервисы биндятся ТОЛЬКО на 127.0.0.1 — наружу только через Cloudflare.
# ============================================

# --- Telegram ---
BOT_TOKEN=
BOT_USERNAME=
WEBHOOK_SECRET=
WEBAPP_URL=
ADMIN_USER_ID=
WORK_GROUP_ID=
PUBLIC_CHANNEL_ID=

# ============================================
# АДРЕСА: внутри контейнеров vs на хосте
# ============================================
# Правило Docker: внутри контейнера "127.0.0.1" — это САМ этот контейнер.
# Чтобы api достучался до db, redis, minio — используем имена сервисов
# из docker-compose (`db`, `redis`, `minio`) как хосты (это DNS compose-сети).
# А "127.0.0.1:<port>" на хосте — это то, что видно с ноутбука/из cloudflared.

# --- FastAPI / API-сервис ---
# APP_HOST=0.0.0.0 — uvicorn должен слушать все интерфейсы внутри контейнера,
# иначе docker-proxy не прокинет запросы. Публикация наружу — 127.0.0.1 на хосте,
# см. docker-compose.dev.yml (`ports: 127.0.0.1:${APP_PORT}:${APP_PORT}`).
APP_HOST=0.0.0.0
APP_PORT=8080
APP_PUBLISH_HOST=127.0.0.1

# --- PostgreSQL 16 ---
# Внутри compose-сети: POSTGRES_HOST_INTERNAL=db (имя сервиса).
# С хоста для psql/DBeaver: 127.0.0.1:${POSTGRES_PORT}.
POSTGRES_HOST_INTERNAL=db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=course_bot
POSTGRES_USER=course_bot
POSTGRES_PASSWORD=
# Лимит shared_buffers для локального Postgres (правило сервера ≤ 256 МБ).
POSTGRES_SHARED_BUFFERS=128MB

# --- Redis 7 (только некритичный буфер аналитики) ---
# Внутри compose: redis://redis:6379/0. С хоста: redis://127.0.0.1:6382/0.
REDIS_URL=redis://redis:6379/0
REDIS_URL_EXTERNAL=redis://127.0.0.1:6382/0

# --- S3 в РФ (провайдер — открытый вопрос Автора) ---
# Внутри compose: http://minio:9000. С хоста / из браузера: http://127.0.0.1:9000.
# prod — Yandex Object Storage / Timeweb / VK Cloud (решение Автора).
# Бакет фото: Object Lock ОТКЛЮЧЁН (иначе стирание невозможно).
# Бакет аудита: COMPLIANCE / WORM.
S3_ENDPOINT=http://minio:9000
S3_ENDPOINT_EXTERNAL=http://127.0.0.1:9000
S3_REGION=ru-central-1
S3_BUCKET_PHOTOS=photos
S3_BUCKET_AUDIT=audit
# Dev-дефолты для локального MinIO. В prod заменить на реальные ключи S3.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Оплата: ВАРИАНТ A (ручной, самозанятый) — активен сейчас ---
# Реквизиты, которые бот показывает клиенту при команде /pay
PAYMENT_MODE=manual
PAYMENT_CARD_NUMBER=            # например: 2200 XXXX XXXX XXXX
PAYMENT_CARD_HOLDER=            # ФИО как на карте
PAYMENT_SBP_PHONE=              # +7XXXXXXXXXX для СБП
PAYMENT_SBP_BANK=               # название банка получателя (Т-Банк, Сбер, ...)
PAYMENT_AMOUNT_RUB=             # цена курса, например 5000
PAYMENT_CURRENCY=RUB

# --- Оплата: ВАРИАНТ B (YooKassa для самозанятых) — на будущее ---
# Заполнить, когда переедем на автомат. Пока оставить пустым.
PSP_PROVIDER=                   # yookassa | robokassa | cloudpayments
PSP_SHOP_ID=
PSP_SECRET_KEY=
PSP_WEBHOOK_SECRET=
PSP_RETURN_URL=                 # URL Mini App, куда возвращать клиента после оплаты

# --- Часовой пояс ---
# Договорённость: в БД храним timestamptz (Postgres хранит в UTC под капотом),
# в приложении конвертим и отображаем в MSK.
# TZ внутри контейнеров = MSK, чтобы логи совпадали с меткой сервера.
TZ=Europe/Moscow
SERVER_TIMEZONE=Europe/Moscow

# --- Лимиты памяти контейнеров (правило IRONCLAD, не превышать) ---
# Суммарно ≤ ~900 MB (RAM свободно ~4.6 ГиБ; maxmover занят ~750-900 MB).
MEM_LIMIT_API=384M
MEM_LIMIT_BOT=192M
MEM_LIMIT_DB=384M
MEM_LIMIT_REDIS=64M
MEM_LIMIT_MINIO=192M

# --- Прочее ---
LOG_LEVEL=INFO
